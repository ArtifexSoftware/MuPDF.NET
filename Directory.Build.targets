<Project>
  <PropertyGroup>
    <ArtifexVersionsGeneratedFile>$(MSBuildThisFileDirectory)build\ArtifexVersions.g.cs</ArtifexVersionsGeneratedFile>
  </PropertyGroup>

  <Target Name="GenerateArtifexVersions"
          BeforeTargets="BeforeCompile"
          Inputs="$(MSBuildThisFileDirectory)Versions.props"
          Outputs="$(ArtifexVersionsGeneratedFile)">
    <MakeDir Directories="$(MSBuildThisFileDirectory)build" />
    <PropertyGroup>
      <_ArtifexVersionCs>// &lt;auto-generated /&gt; Source: Versions.props. Do not edit.
namespace Artifex
{
    /// &lt;summary&gt;Central version constants for the MuPDF.NET solution.&lt;/summary&gt;
    public static class Versions
    {
        /// &lt;summary&gt;Native MuPDF library (FZ_VERSION / MuPDF.NativeAssets).&lt;/summary&gt;
        public const string MuPDF = "$(ArtifexMuPDFVersion)"%3B

        /// &lt;summary&gt;MuPDF.NET NuGet package.&lt;/summary&gt;
        public const string MuPDFNet = "$(ArtifexMuPDFNetVersion)"%3B

        /// &lt;summary&gt;Layout-worker version pin (layout ships in the layout wheel).&lt;/summary&gt;
        public const string PyMuPDFLayout = "$(ArtifexPyMuPDFLayoutVersion)"%3B
    }
}
</_ArtifexVersionCs>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(ArtifexVersionsGeneratedFile)"
      Lines="$(_ArtifexVersionCs)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MuPDF.NET'">
    <Compile Include="$(ArtifexVersionsGeneratedFile)" />
  </ItemGroup>

  <PropertyGroup>
    <MuPDFNetPDF4LLMVersionsGeneratedFile>$(MSBuildThisFileDirectory)build\MuPDFNetPDF4LLMVersions.g.cs</MuPDFNetPDF4LLMVersionsGeneratedFile>
  </PropertyGroup>

  <Target Name="GenerateMuPDFNetPDF4LLMVersions"
          BeforeTargets="CoreCompile;BeforeCompile;Compile"
          Condition="'$(MSBuildProjectName)' == 'MuPDF.NET'"
          Inputs="$(MSBuildThisFileDirectory)Versions.props"
          Outputs="$(MuPDFNetPDF4LLMVersionsGeneratedFile)">
    <MakeDir Directories="$(MSBuildThisFileDirectory)build" />
    <PropertyGroup>
      <_VersionCs>// &lt;auto-generated /&gt; Source: Versions.props. Do not edit.
namespace MuPDF.NET.PDF4LLM
{
    /// &lt;summary&gt;Build-time version pins for 4llm sources compiled into MuPDF.NET (from Versions.props).&lt;/summary&gt;
    internal static class BuildVersions
    {
        public const string Package = "$(ArtifexMuPDFNetVersion)"%3B
        public const string RequiredMuPdf = "$(ArtifexMuPDFVersion)"%3B
        public const string RequiredPyMuPDFLayout = "$(ArtifexPyMuPDFLayoutVersion)"%3B
        public const string MuPDFNet = "$(ArtifexMuPDFNetVersion)"%3B
    }
}
</_VersionCs>
    </PropertyGroup>
    <WriteLinesToFile
      File="$(MuPDFNetPDF4LLMVersionsGeneratedFile)"
      Lines="$(_VersionCs)"
      Overwrite="true"
      Encoding="UTF-8" />
  </Target>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'MuPDF.NET'">
    <Compile Include="$(MuPDFNetPDF4LLMVersionsGeneratedFile)" />
  </ItemGroup>
</Project>
