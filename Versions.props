<Project>
  <!--
    Single source of truth for Artifex product versions in this solution.
    Edit only here; C# constants are generated into build/ArtifexVersions.g.cs.
  -->
  <PropertyGroup Label="Artifex product versions">
    <!-- Native MuPDF C library (FZ_VERSION / MuPDF.NativeAssets). -->
    <ArtifexMuPDFVersion>1.28.6</ArtifexMuPDFVersion>
	
    <!-- MuPDF.NET NuGet package. -->
    <ArtifexMuPDFNetVersion>4.1.0</ArtifexMuPDFNetVersion>
	
    <!-- Deprecated: MuPDF.NET.PDF4LLM NuGet (empty type-forward stub; will be removed). Sources live in MuPDF.NET/PDF4LLM. -->
    <ArtifexMuPDFNetPDF4LLMVersion>2.1.0</ArtifexMuPDFNetPDF4LLMVersion>
	
    <!-- MuPDF.NET.Office (+ NativeAssets) NuGet packages; same version always. -->
    <ArtifexMuPDFNetOfficeVersion>2.1.0</ArtifexMuPDFNetOfficeVersion>
	
    <!-- pymupdf 2.1 wheel includes layout; pymupdf-layout 2.1 is the empty pip-upgrade stub. -->
    <ArtifexPyMuPDFLayoutVersion>2.1</ArtifexPyMuPDFLayoutVersion>
  </PropertyGroup>
</Project>
