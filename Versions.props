<Project>
  <!--
    Single source of truth for Artifex product versions in this solution.
    Edit only here; C# constants are generated into build/ArtifexVersions.g.cs.
  -->
  <PropertyGroup Label="Artifex product versions">
    <!-- Native MuPDF C library (FZ_VERSION / MuPDF.NativeAssets). -->
    <ArtifexMuPDFVersion>1.28.0.3</ArtifexMuPDFVersion>
	
    <!-- MuPDF.NET NuGet package. -->
    <ArtifexMuPDFNetVersion>3.28.1.6</ArtifexMuPDFNetVersion>
	
    <!-- MuPDF.NET.PDF4LLM NuGet package. -->
    <ArtifexMuPDFNetPDF4LLMVersion>1.28.0.3</ArtifexMuPDFNetPDF4LLMVersion>
	
    <!-- MuPDF.NET.Office (+ NativeAssets) NuGet packages; same version always. -->
    <ArtifexMuPDFNetOfficeVersion>1.28.0.3</ArtifexMuPDFNetOfficeVersion>
	
    <!-- pymupdf-layout (and pymupdf) PyPI pin for the MuPDF.NET.PDF4LLM layout bridge. -->
    <ArtifexPyMuPDFLayoutVersion>1.28.0</ArtifexPyMuPDFLayoutVersion>
  </PropertyGroup>
</Project>
