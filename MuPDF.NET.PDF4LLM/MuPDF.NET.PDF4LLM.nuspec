<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>MuPDF.NET.PDF4LLM</id>
    <version>$version$</version>
    <authors>Artifex Software Inc.</authors>
    <owners>Artifex Software Inc.</owners>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.md</license>
    <icon>logo.png</icon>
    <readme>Description.md</readme>
    <projectUrl>https://docs.pdf4llm.com/</projectUrl>
    <description>Deprecated. Will be removed. Empty 2.1 type-forward stub (PyPI pymupdf4llm 2.1). Use MuPDF.NET 4.1 (Document.ToMarkdown / Utils.UseLayout / Utils.LoadAiAsync) and MuPDF.NET.Office 2.1. Do not add this package to new projects.</description>
    <releaseNotes>2.1.0 is deprecated and will be removed. Empty type-forward stub; sources compile into MuPDF.NET 4.1. Layout worker and OCR models ship in the MuPDF.NET nupkg. Migrate to MuPDF.NET / MuPDF.NET.Office.</releaseNotes>
    <tags>deprecated MuPDF PDF LLM RAG Markdown LlamaIndex document-processing PDF-to-text</tags>
    <repository type="git" url="https://github.com/ArtifexSoftware/MuPDF.NET" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.1">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.8">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net5.0">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net7.0">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="MuPDF.NET" version="[$mupdfNetMinVersion$,)" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$Configuration$\netstandard2.0\MuPDF.NET.PDF4LLM.dll" target="lib\netstandard2.0\" />
    <file src="bin\$Configuration$\net461\MuPDF.NET.PDF4LLM.dll" target="lib\net461\" />
    <file src="bin\$Configuration$\net472\MuPDF.NET.PDF4LLM.dll" target="lib\net472\" />
    <file src="bin\$Configuration$\net48\MuPDF.NET.PDF4LLM.dll" target="lib\net48\" />
    <file src="bin\$Configuration$\net5.0\MuPDF.NET.PDF4LLM.dll" target="lib\net5.0\" />
    <file src="bin\$Configuration$\net6.0\MuPDF.NET.PDF4LLM.dll" target="lib\net6.0\" />
    <file src="bin\$Configuration$\net7.0\MuPDF.NET.PDF4LLM.dll" target="lib\net7.0\" />
    <file src="bin\$Configuration$\net8.0\MuPDF.NET.PDF4LLM.dll" target="lib\net8.0\" />
    <file src="LICENSE.md" target="" />
    <file src="Description.md" target="" />
    <file src="logo.png" target="" />
  </files>
</package>
